        "jsCode": "// TRASFORMAZIONE IN BASE64\n// Verifica che il file binario esista\nconst binaryProp = items[0].binary ? items[0].binary.data : null;\n\nif (!binaryProp) {\n  throw new Error(\"❌ NESSUN FILE TROVATO: Il nodo Webhook non ha ricevuto l'immagine nel campo 'data'.\");\n}\n\nconst base64String = binaryProp.data;\nconst mimeType = binaryProp.mimeType || 'image/png';\n\n// Recuperiamo i dati dal body del Webhook\nconst inputBody = $('Webhook').first().json.body || $('Webhook').first().json;\n\nreturn {\n  json: {\n    // 1. Dati per Fal.ai\n    data_uri: `data:${mimeType};base64,${base64String}`,\n    \n    // 2. Dati passanti (Prompt e Sessione)\n    prompt: inputBody.prompt || \"Cinematic shot\",\n    session_id: inputBody.session_id,\n    \n    // 3. IL PEZZO MANCANTE (Fondamentale per lo Switch!)\n    // Se non c'è, mettiamo 'svd' come default di sicurezza\n    model_type: inputBody.model_type || 'svd' \n  }\n};"
      },
