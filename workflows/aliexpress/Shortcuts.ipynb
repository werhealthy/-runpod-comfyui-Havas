import os
import time
import subprocess
import signal

# --- Configurazione Percorsi Assoluti ---
BASE_DIR = "/tmp/comfyui"
FRONTEND_DIR = os.path.join(BASE_DIR, "frontends", "aliexpress")
APP_SCRIPT = os.path.join(FRONTEND_DIR, "app.py")

print("=========================================")
print("   🔄 RIAVVIO GRADIO (AliExpress)")
print("=========================================")
print(f"📂 Cartella Frontend: {FRONTEND_DIR}")
print(f"📄 File App: {APP_SCRIPT}")

# --- 1. Termina Processi Gradio Attivi ---
print("\n🛑 1. Cerco e termino vecchie istanze...")

# Pkill più aggressivo che cerca specificamente "python3 ... app.py" o "python ... app.py"
# Ignora se stesso per evitare suicidi accidentali
try:
    cmd = "pkill -f 'app.py'"
    subprocess.run(cmd, shell=True)
    print("   ✅ Segnale di kill inviato.")
except Exception as e:
    print(f"   ⚠️ Warning su kill: {e}")

# --- 2. Attesa ---
print("\n⏳ 2. Attendo 2 secondi che la porta 7860 si liberi...")
time.sleep(2)

# --- 3. Rilancio Gradio ---
print("\n🚀 3. Avvio Gradio...")

if not os.path.exists(APP_SCRIPT):
    print(f"❌ ERRORE CRITICO: File non trovato: {APP_SCRIPT}")
    print("   Hai eseguito l'installazione del workflow?")
else:
    # Cambiamo la working directory prima di lanciare, così app.py trova i suoi asset relativi
    os.chdir(FRONTEND_DIR)
    
    try:
        # Eseguiamo python3 app.py
        # check=True fa sì che se crasha subito, vediamo l'errore Python
        subprocess.run(f"python3 {APP_SCRIPT}", shell=True, check=True)
    except subprocess.CalledProcessError as e:
        print(f"\n❌ Gradio è crashato o è stato fermato (Exit code: {e.returncode})")
    except KeyboardInterrupt:
        print("\n👋 Fermato dall'utente.")
