    "import os\n",
    "import time\n",
    "import subprocess\n",
    "\n",
    "# --- Configurazione ---\n",
    "COMFY_DEFAULT_DIR = \"/tmp/comfyui\"\n",
    "COMFY_MAIN_NAME = \"main.py\"\n",
    "SEARCH_ROOTS = [COMFY_DEFAULT_DIR, \"/workspace\", \"/root\", \"/tmp\"]\n",
    "\n",
    "def find_comfy_main():\n",
    "    default_main = os.path.join(COMFY_DEFAULT_DIR, COMFY_MAIN_NAME)\n",
    "    if os.path.isfile(default_main):\n",
    "        return default_main\n",
    "\n",
    "    for root in SEARCH_ROOTS:\n",
    "        if not os.path.isdir(root):\n",
    "            continue\n",
    "        for dirpath, dirnames, filenames in os.walk(root):\n",
    "            if COMFY_MAIN_NAME in filenames and \"comfy\" in dirpath.lower():\n",
    "                return os.path.join(dirpath, COMFY_MAIN_NAME)\n",
    "    return None\n",
    "\n",
    "print(\"🔎 0. Ricerca di ComfyUI main.py...\")\n",
    "comfy_main_path = find_comfy_main()\n",
    "\n",
    "if not comfy_main_path:\n",
    "    print(\"❌ main.py non trovato.\")\n",
    "else:\n",
    "    comfy_dir = os.path.dirname(comfy_main_path)\n",
    "    print(f\"✅ ComfyUI main.py trovato in: {comfy_main_path}\")\n",
    "\n",
    "    print(\" 1. Uccisione istanze precedenti di ComfyUI...\")\n",
    "    subprocess.run(\"pkill -f 'python main.py' || true\", shell=True)\n",
    "    subprocess.run(\"pkill -f 'python3 main.py' || true\", shell=True)\n",
    "    print(\"✅ Vecchie istanze terminate.\")\n",
    "\n",
    "    print(\"⏳ 2. Attesa 3s per liberare la porta...\")\n",
    "    time.sleep(3)\n",
    "\n",
    "    print(\" 3. Avvio ComfyUI in background su 0.0.0.0:8188...\")\n",
    "    cmd = [\n",
    "        \"python\", \"main.py\",\n",
    "        \"--listen\", \"0.0.0.0\",\n",
    "        \"--port\", \"8188\",\n",
    "        \"--enable-cors-header\",\n",
    "        \"--preview-method\", \"auto\"\n",
    "    ]\n",
    "\n",
    "    try:\n",
    "        log_path = os.path.join(comfy_dir, \"comfyui_jupyter.log\")\n",
    "        proc = subprocess.Popen(\n",
    "            cmd,\n",
    "            cwd=comfy_dir,\n",
    "            stdout=open(log_path, \"a\"),\n",
    "            stderr=subprocess.STDOUT\n",
    "        )\n",
    "        print(f\"✨ ComfyUI avviato (PID {proc.pid})\")\n",
    "        print(f\"📄 Log: {log_path}\")\n",
    "    except Exception as e:\n",
    "        print(f\"❌ Errore durante l'avvio: {e}\")\n"
   ]
  }
