      "parameters": {
        "jsCode": "// TRASFORMAZIONE IN BASE64\n// Verifica che il file binario esista\nconst binaryProp = items[0].binary ? items[0].binary.data : null;\n\nif (!binaryProp) {\n  throw new Error(\"❌ NESSUN FILE TROVATO: Il nodo Webhook non ha ricevuto l'immagine nel campo 'data'.\");\n}\n\nconst base64String = binaryProp.data;\nconst mimeType = binaryProp.mimeType || 'image/png';\n\n// Recuperiamo i dati dal body del Webhook\nconst inputBody = $('Webhook').first().json.body || $('Webhook').first().json;\nconst rawModel = $('Webhook').first().json.body.model_type;\n\n// Normalizza sempre a stringa \"kling\" / \"svd\"\nlet model_type = \"kling\"; // ✅ default\nif (rawModel !== undefined && rawModel !== null && rawModel !== \"\") {\n  const s = String(rawModel).toLowerCase();\n  if (s.includes(\"svd\") || s === \"2\") model_type = \"svd\";\n  if (s.includes(\"kling\") || s === \"1\") model_type = \"kling\";\n}\n\nreturn {\n  json: {\n    data_uri: `data:${mimeType};base64,${base64String}`,\n    prompt: $('Webhook').first().json.body.prompt || \"Cinematic zoom\",\n    session_id: $('Webhook').first().json.body.session_id,\n    image_filename: $('Webhook').first().json.body.image_filename,\n    model_type, // ✅ aggiunto\n  }\n};\n"
      },
